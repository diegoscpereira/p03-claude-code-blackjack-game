{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run check:bundle)",
      "Bash(npm run generate:ev)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Read"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-sdd-flow.mjs",
            "timeout": 10,
            "statusMessage": "Checking spec coverage"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-branch-sync.mjs",
            "if": "Bash(git commit*)",
            "timeout": 30,
            "statusMessage": "Checking branch is up to date"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-branch-sync.mjs",
            "if": "Bash(git push*)",
            "timeout": 30,
            "statusMessage": "Checking branch is up to date"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-no-secrets.mjs",
            "if": "Bash(git push*)",
            "timeout": 20,
            "statusMessage": "Scanning outgoing commits for credentials"
          }
        ]
      }
    ]
  }
}
