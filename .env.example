# T010 — persistence configuration.
#
# BOTH of these are SERVER-SIDE ONLY. They are read exclusively inside api/,
# which is the only code in this repository that holds a database credential.
#
# Never prefix either with VITE_. Vite inlines any VITE_-prefixed variable into
# the client bundle at build time, so a VITE_SUPABASE_SERVICE_KEY would ship the
# service key to every visitor's browser. `npm run check:bundle` fails the build
# if that happens — see NFR-006 and the constitution's Data Safety gate.
#
# The game is fully playable with neither of these set. Progression stays local
# and the sync indicator shows pending forever, which is FR-062 working.

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
