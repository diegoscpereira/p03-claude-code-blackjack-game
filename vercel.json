{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run generate:ev && npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/*.ts": {
      "runtime": "@vercel/node@3.2.0",
      "maxDuration": 10
    }
  },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
